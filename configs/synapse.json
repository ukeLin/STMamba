{
  "dataset": "Synapse",
  "task": "multiclass",
  "image_size": 224,
  "num_classes": 9,
  "list_dir": "training/splits/synapse",
  "label_format": "original13",
  "epochs": 300,
  "batch_size": 32,
  "lr": 0.0005,
  "weight_decay": 0.001,
  "min_lr": 1e-06,
  "aux_weight": 0.0,
  "ce_weight": 0.5,
  "dice_weight": 0.5,
  "supervision": "final",
  "training_protocol": "monai",
  "precision": "fp32",
  "gradient_clip_norm": 1.0,
  "workers": 6,
  "matmul_precision": "medium",
  "cudnn_enabled": false,
  "deterministic": true,
  "architecture": "STMamba-v3-LDF",
  "data_pipeline": "monai",
  "use_skip_fusion": true,
  "fusion_options": {
    "foreground_mode": "nonbackground"
  },
  "keep_last": 5,
  "eval_interval": 50
}
